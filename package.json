{
  "name": "noteagents",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.0.0",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ]
  },
  "scripts": {
    "build": "pnpm --filter noteagents-web build",
    "dev": "pnpm --filter noteagents-web dev",
    "dev:server": "tsx watch server/index.ts",
    "start:server": "tsx server/index.ts",
    "lint": "eslint apps/web packages/contracts --config .eslintrc.json --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "vitest run --e2e",
    "typecheck": "pnpm --filter @noteagents/contracts typecheck && pnpm --filter noteagents-web typecheck",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.11.6",
    "@types/pino": "^7.0.5",
    "@types/pino-pretty": "^5.0.0",
    "@eslint/eslintrc": "^3.3.1",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.33",
    "next": "14.2.33",
    "pino": "^9.0.0",
    "pino-pretty": "^5.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.5"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "simple-git": "^4.0.2",
    "zod": "^3.25.76"
  }
}
